<Window x:Class="TwitchBetBot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:helpers="clr-namespace:TwitchBetBot"
        Title="Kuraga Bot" 
        Height="700" 
        Width="950"
        WindowStartupLocation="CenterScreen">

  

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Kuraga BetBot" 
                           Foreground="White" 
                           FontSize="16" 
                           FontWeight="Bold"/>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock Text="Режим:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ToggleButton x:Name="ModeToggle" Width="100" Height="25" 
                                  Checked="ModeToggle_Checked" Unchecked="ModeToggle_Unchecked"
                                  Background="#444" Foreground="White">
                        <ToggleButton.Content>
                            <TextBlock x:Name="ModeToggleText" Text="🎯 Трекер"/>
                        </ToggleButton.Content>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Orientation="Horizontal" x:Name="ConnectionStatusPanel">
                    <Ellipse Width="10" Height="10" Margin="10,0,5,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="Red"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="LimeGreen"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding IsConnected, Converter={StaticResource BoolToString}}"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                </StackPanel>

                <Ellipse Width="10" Height="10" Margin="20,0,5,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="Gray"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                    <Setter Property="Fill" Value="Orange"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding IsMonitoring, Converter={StaticResource BoolToString}, ConverterParameter='Мониторинг|Выкл'}"
                           Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ========== ВКЛАДКИ ========== -->
        <TabControl x:Name="MainTabControl" 
                    Grid.Row="1" 
                    SelectionChanged="TabControl_SelectionChanged">

            <!-- ================================================================ -->
            <!-- Вкладка 1: Управление -->
            <!-- ================================================================ -->
            <TabItem Header="🎮 Управление">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel - Controls -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <!-- Auth Section -->
                            <GroupBox Header="Авторизация" Margin="0,0,0,10" x:Name="AuthSection">
                                <StackPanel Margin="0,0,0,5">
                                    <TextBlock Text="Access Token:" Margin="0,5,0,2"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="AccessTokenTextBox" 
                                                 Grid.Column="0"
                                                 Text="{Binding AccessToken, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="Collapsed"
                                                 Margin="0,0,5,0"/>

                                        <PasswordBox x:Name="AccessTokenPasswordBox" 
                                                     Grid.Column="0"
                                                     helpers:PasswordBoxHelper.Attach="True"
                                                     helpers:PasswordBoxHelper.Password="{Binding AccessToken}"
                                                     Margin="0,0,5,0"/>

                                        <ToggleButton x:Name="ShowTokenToggle" 
                                                      Grid.Column="1"
                                                      Width="30" 
                                                      Height="30"
                                                      Checked="ShowTokenToggle_Checked"
                                                      Unchecked="ShowTokenToggle_Unchecked"
                                                      ToolTip="Показать/скрыть токен">
                                            <ToggleButton.Content>
                                                <TextBlock x:Name="ToggleButtonText" Text="👁️" FontSize="16"/>
                                            </ToggleButton.Content>
                                        </ToggleButton>
                                    </Grid>

                                    <TextBlock Text="Client ID:" Margin="0,5,0,2"/>
                                    <TextBox Text="{Binding ClientId}" Margin="0,0,0,5"/>

                                    <TextBlock Text="Имя канала:" Margin="0,5,0,2"/>
                                    <TextBox Text="{Binding ChannelName}" Margin="0,0,0,5"/>

                                    <Button Content="Подключиться" 
                                            Command="{Binding ConnectCommand}"
                                            Height="30"
                                            Background="#6441A5"
                                            Foreground="White"/>
                                    <Button Content="🔐 Получить токен через Twitch" 
        Command="{Binding GetTokenViaOAuthCommand}"
        Height="30"
        Background="#9146FF"
        Foreground="White"
        Margin="0,5,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Chat Bot Section -->
                            <GroupBox Header="Чат-бот" Margin="0,0,0,10" x:Name="ChatBotSection">
                                <StackPanel>
                                    <TextBlock Text="Имя бота:" Margin="0,5,0,2"/>
                                    <TextBox Text="{Binding BotUsername}" 
                                             Margin="0,0,0,5"
                                             ToolTip="Аккаунт бота"/>

                                    <TextBlock Text="OAuth токен бота:" Margin="0,5,0,2"/>
                                    <TextBox Text="{Binding BotAccessToken}" 
                                             Margin="0,0,0,5"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Content="Запустить бота" 
                                                Command="{Binding StartChatBotCommand}"
                                                Height="30"
                                                Margin="0,0,5,0"
                                                Background="Green"
                                                Foreground="White"
                                                Grid.Column="0"/>

                                        <Button Content="Остановить бота" 
                                                Command="{Binding StopChatBotCommand}"
                                                Height="30"
                                                Margin="5,0,0,0"
                                                Background="#FF0000"
                                                Foreground="White"
                                                Grid.Column="1"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Статус: " FontSize="11" Foreground="Gray"/>
                                        <Ellipse Width="8" Height="8" Margin="5,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="Red"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChatBotRunning}" Value="True">
                                                            <Setter Property="Fill" Value="LimeGreen"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding IsChatBotRunning, Converter={StaticResource BoolToString}, ConverterParameter='Работает|Отключён'}" 
                                                   FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <!-- Automation Section -->
                            <GroupBox Header="Автоматизация" Margin="0,0,0,10">
                                <StackPanel>
                                    <Button Content="{Binding IsMonitoring, Converter={StaticResource BoolToString}, ConverterParameter='Остановить мониторинг|Запустить мониторинг'}" 
                                            Command="{Binding ToggleMonitoringCommand}"
                                            Height="30" 
                                            Margin="0,5"
                                            Background="{Binding IsMonitoring, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Red|Green'}"
                                            Foreground="White"/>

                                    <TextBlock Text="Автоматически создает и завершает ставки"
                                               FontSize="11"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0"/>

                                    <GroupBox Header="GSI Управление" Margin="0,10,0,0">
                                        <StackPanel>
                                            <Button Content="Запустить GSI" 
                                                    Command="{Binding StartGSICommand}"
                                                    Height="30" 
                                                    Margin="0,5"
                                                    Background="Green"
                                                    Foreground="White"/>

                                            <Button Content="Остановить GSI" 
                                                    Command="{Binding StopGSICommand}"
                                                    Height="30" 
                                                    Margin="0,5"
                                                    Background="Red"
                                                    Foreground="White"/>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </GroupBox>

                            <!-- Prediction Controls -->
                            <GroupBox Header="Управление Predictions" Margin="0,0,0,10" x:Name="PredictionSection">
                                <StackPanel>
                                    <Button Content="Создать Prediction" 
                                            Command="{Binding CreatePredictionCommand}"
                                            Height="30" 
                                            Margin="0,5"
                                            Background="#3498db"
                                            Foreground="White"/>

                                    <Button Content="Закрыть прием" 
                                            Command="{Binding LockPredictionCommand}"
                                            Height="30" 
                                            Margin="0,5"
                                            Background="#e74c3c"
                                            Foreground="White"/>

                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Content="Завершить (Win)" 
                                                Command="{Binding EndPredictionWinCommand}"
                                                Height="30"
                                                Margin="0,0,2,0"
                                                Background="#27ae60"
                                                Foreground="White"/>

                                        <Button Content="Завершить (Lose)" 
                                                Command="{Binding EndPredictionLoseCommand}"
                                                Height="30"
                                                Margin="2,0,0,0"
                                                Background="#c0392b"
                                                Foreground="White"
                                                Grid.Column="1"/>
                                    </Grid>

                                    <Button Content="Отменить" 
                                            Command="{Binding CancelPredictionCommand}"
                                            Height="30" 
                                            Margin="0,5"
                                            Background="#95a5a6"
                                            Foreground="White"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Config -->
                            <GroupBox Header="Настройки" Margin="0,0,0,10">
                                <StackPanel>
                                    <Button Content="Сохранить настройки" 
                                            Command="{Binding SaveConfigCommand}"
                                            Height="25"
                                            Margin="0,5"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Status Info -->
                            <Border Background="#f8f9fa" BorderBrush="#ddd" BorderThickness="1" 
                                    CornerRadius="5" Padding="10" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Текущий статус:" FontWeight="Bold" Margin="0,0,0,5"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Подключение:" Width="100"/>
                                        <Ellipse Width="8" Height="8" Margin="5,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="Red"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Fill" Value="LimeGreen"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding IsConnected, Converter={StaticResource BoolToString}}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Мониторинг:" Width="100"/>
                                        <Ellipse Width="8" Height="8" Margin="5,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="Gray"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                            <Setter Property="Fill" Value="Orange"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding IsMonitoring, Converter={StaticResource BoolToString}, ConverterParameter='Активен|Выкл'}"/>
                                    </StackPanel>

                                    <Separator Margin="0,5"/>

                                    <TextBlock Text="Активная ставка:" FontWeight="Bold" Margin="0,5,0,2"/>
                                    <TextBlock Text="{Binding CurrentPrediction.Title}" 
                                               TextWrapping="Wrap"
                                               FontStyle="Italic"
                                               Foreground="#555"
                                               Visibility="{Binding CurrentPrediction, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    <TextBlock Text="Нет активных ставок" 
                                               FontStyle="Italic"
                                               Foreground="#999"
                                               Visibility="{Binding CurrentPrediction, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Invert'}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Logs -->
                    <Grid Grid.Column="1" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <GroupBox Header="Логи" Grid.Row="0">
                            <TextBox Text="{Binding LogText}" 
                                     IsReadOnly="True" 
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Background="#1e1e1e"
                                     Foreground="#d4d4d4"
                                     BorderThickness="0"
                                     TextChanged="LogTextBox_TextChanged"/>
                        </GroupBox>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                            <Button Content="Очистить логи" 
                                    Height="25" 
                                    Width="100"
                                    Click="ClearLogs_Click"
                                    Margin="0,0,5,0"/>
                            <Button Content="Копировать логи" 
                                    Height="25" 
                                    Width="120"
                                    Click="CopyLogs_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================================================================ -->
            <!-- Вкладка 2: YouTube Музыка -->
            <!-- ================================================================ -->
            <TabItem x:Name="YouTubeTab" Header="🎵 YouTube Музыка">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="CurrentMusicStatus" 
                       Text="🎵 Ожидание..." 
                       VerticalAlignment="Center"
                       Foreground="Gray"/>
                    </StackPanel>

                    <wpf:WebView2 x:Name="YouTubePlayer" 
                      Grid.Row="1"/>
                </Grid>
            </TabItem>

            <!-- ================================================================ -->
            <!-- Вкладка 3: Настройки -->
            <!-- ================================================================ -->
            <TabItem Header="⚙️ Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <!-- Автоматизация -->
                        <GroupBox Header="🤖 Автоматизация" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="AutomationCheckBox" 
                                          Content="Включить автоматическое создание и завершение ставок"
                                          IsChecked="{Binding AutomationEnabled}"
                                          FontWeight="SemiBold"
                                          Margin="0,5"/>
                                <TextBlock Text="При выключении бот не будет создавать и завершать ставки автоматически"
                                           FontSize="11"
                                           Foreground="Gray"
                                           Margin="25,2,0,5"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Тип ставки -->
                        <GroupBox Header="🎲 Тип ставки по умолчанию" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="chkWinLose" 
                  Content="Win/Lose (кто победит в матче)"
                  Checked="PredictionType_Checked"
              
                  Tag="WinLose"
                  Margin="0,4"/>

                                <CheckBox x:Name="chkFirstBlood" 
                  Content="First Blood (какая команда сделает первую кровь)"
                  Checked="PredictionType_Checked"
              
                  Tag="FirstBlood"
                  Margin="0,4"/>

                                <CheckBox x:Name="chkRoshanKill" 
                  Content="RoshanKill (какая команда первой убьёт Рошана)"
                  Checked="PredictionType_Checked"
          
                  Tag="RoshanKill"
                  Margin="0,4"/>

                                <CheckBox x:Name="chkFBThenWinLose" 
                  Content="First Blood → Win/Lose (две ставки по очереди)"
                  Checked="PredictionType_Checked"
               
                  Tag="FirstBloodThenWinLose"
                  Margin="0,4"/>

                                <CheckBox x:Name="chkFBThenRoshanKill" 
                  Content="First Blood → RoshanKill (две ставки по очереди)"
                  Checked="PredictionType_Checked"
              
                  Tag="FirstBloodThenRoshanKill"
                  Margin="0,4"/>

                                <TextBlock Text="Выбранный тип будет использоваться при автоматическом создании ставок"
                   FontSize="11"
                   Foreground="Gray"
                   Margin="20,5,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Настройки времени -->
                        <GroupBox Header="⏱️ Настройки времени" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Время приёма ставок:" Width="180" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding PredictionWindowSeconds}" Width="80" Margin="5,0"/>
                                    <TextBlock Text="секунд" VerticalAlignment="Center" Margin="5,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- Dota 2 -->
                        <GroupBox Header="🎮 Dota 2" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Порт GSI:" Width="120" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding GsiPort}" Width="80" Margin="5,0"/>
                                </StackPanel>

                                

                                <TextBlock Text="Изменение порта требует перезапуска приложения и удаления конфига из папки доты"
                                           FontSize="11"
                                           Foreground="Orange"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Статистика и MMR -->
                        <GroupBox Header="📊 Статистика" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Текущий MMR:" Width="120" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding CurrentMmr}" Width="100" Margin="5,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                    <TextBlock Text="Ранг:" Width="120" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RankTitle}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="MMR меняется автоматически после рейтинговых игр (±25). При ручном изменении сохраняется в конфиг."
                                           FontSize="11"
                                           Foreground="Gray"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Чат-бот -->
                        <GroupBox Header="💬 Чат-бот" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <CheckBox Content="Автоматически запускать чат-бота при подключении к Twitch"
                                          IsChecked="{Binding AutoStartChatBot}"
                                          Margin="0,5"/>

                                <TextBlock Text="Бот отвечает на команды: !pts, !wl, !stats, !music, !help"
                                           FontSize="11"
                                           Foreground="Gray"
                                           Margin="25,5,0,0"/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
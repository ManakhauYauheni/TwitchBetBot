<Window x:Class="TwitchBetBot.Views.MainWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:TwitchBetBot"
        Title="Kuraga Bot" 
        Height="650" 
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Kuraga BetBot" 
                          Foreground="White" 
                          FontSize="16" 
                          FontWeight="Bold"/>

                <!-- Статус подключения -->
                <Ellipse Width="10" Height="10" Margin="10,0,5,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="Red"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="LimeGreen"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Text="{Binding IsConnected, Converter={StaticResource BoolToString}}"
                          Foreground="White"
                          VerticalAlignment="Center"
                          Margin="0,0,20,0"/>

                <!-- Статус мониторинга -->
                <Ellipse Width="10" Height="10" Margin="20,0,5,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="Gray"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                    <Setter Property="Fill" Value="Orange"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Text="{Binding IsMonitoring, Converter={StaticResource BoolToString}, ConverterParameter='Мониторинг|Выкл'}"
                          Foreground="White"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Controls -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <!-- Auth Section -->
                    <GroupBox Header="Авторизация" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Access Token:" Margin="0,5,0,2"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Тот же TextBox и PasswordBox что и выше -->
                                <TextBox x:Name="AccessTokenTextBox" 
                 Grid.Column="0"
                 Text="{Binding AccessToken, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="Collapsed"
                 Margin="0,0,5,0"/>

                                <PasswordBox x:Name="AccessTokenPasswordBox" 
                     Grid.Column="0"
                     helpers:PasswordBoxHelper.Attach="True"
                     helpers:PasswordBoxHelper.Password="{Binding AccessToken}"
                     Margin="0,0,5,0"/>

                                <!-- ToggleButton для показа/скрытия -->
                                <ToggleButton x:Name="ShowTokenToggle" 
                      Grid.Column="1"
                      Width="30" 
                      Height="30"
                      Checked="ShowTokenToggle_Checked"
                      Unchecked="ShowTokenToggle_Unchecked"
                      ToolTip="Показать/скрыть токен">
                                    <ToggleButton.Content>
                                        <TextBlock x:Name="ToggleButtonText" Text="👁️" FontSize="16"/>
                                    </ToggleButton.Content>
                                </ToggleButton>
                            </Grid>

                            <!-- Индикатор сохранения -->
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Токен сохранен: " FontSize="10" Foreground="Gray"/>
                                <Ellipse Width="8" Height="8" Fill="Green" Margin="2,0"/>
                            </StackPanel>
                      

                        <TextBlock Text="Client ID:" Margin="0,5,0,2"/>
                            <TextBox Text="{Binding ClientId}" 
                                    Margin="0,0,0,5"/>

                            <TextBlock Text="Имя канала:" Margin="0,5,0,2"/>
                            <TextBox Text="{Binding ChannelName}" 
                                    Margin="0,0,0,5"/>

                            <Button Content="Подключиться" 
                                    Command="{Binding ConnectCommand}"
                                    Height="30"
                                    Background="#6441A5"
                                    Foreground="White"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Automation Section -->
                    <GroupBox Header="Автоматизация" Margin="0,0,0,10">
                        <StackPanel>
                            <Button Content="{Binding IsMonitoring, Converter={StaticResource BoolToString}, ConverterParameter='Остановить мониторинг|Запустить мониторинг'}" 
                                    Command="{Binding ToggleMonitoringCommand}"
                                    Height="30" 
                                    Margin="0,5"
                                    Background="{Binding IsMonitoring, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Red|Green'}"
                                    Foreground="White"/>

                            <TextBlock Text="Автоматически создает и завершает ставки"
                                       FontSize="11"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>

                            <GroupBox Header="GSI Управление" Margin="0,10,0,0">
                                <StackPanel>
                                    <Button Content="Запустить GSI" 
                Command="{Binding StartGSICommand}"
                Height="30" 
                Margin="0,5"
                Background="Green"
                Foreground="White"/>

                                    <Button Content="Остановить GSI" 
                Command="{Binding StopGSICommand}"
                Height="30" 
                Margin="0,5"
                Background="Red"
                Foreground="White"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </GroupBox>

                    <!-- Prediction Controls -->
                    <GroupBox Header="Управление Predictions" Margin="0,0,0,10">
                        <StackPanel>
                            <Button Content="Создать Prediction" 
                                    Command="{Binding CreatePredictionCommand}"
                                    Height="30" 
                                    Margin="0,5"
                                    Background="#3498db"
                                    Foreground="White" Click="Button_Click"/>

                            <Button Content="Закрыть прием" 
                                    Command="{Binding LockPredictionCommand}"
                                    Height="30" 
                                    Margin="0,5"
                                    Background="#e74c3c"
                                    Foreground="White"/>

                            <!-- Две кнопки для завершения -->
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Content="Завершить (Radiant)" 
                                        Command="{Binding EndPredictionRadiantCommand}"
                                        Height="30"
                                        Margin="0,0,2,0"
                                        Background="#27ae60"
                                        Foreground="White"/>

                                <Button Content="Завершить (Dire)" 
                                        Command="{Binding EndPredictionDireCommand}"
                                        Height="30"
                                        Margin="2,0,0,0"
                                        Background="#c0392b"
                                        Foreground="White"
                                        Grid.Column="1"/>
                            </Grid>

                            <Button Content="Отменить" 
                                    Command="{Binding CancelPredictionCommand}"
                                    Height="30" 
                                    Margin="0,5"
                                    Background="#95a5a6"
                                    Foreground="White"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Config -->
                    <GroupBox Header="Настройки" Margin="0,0,0,10">
                        <StackPanel>
                            <Button Content="Сохранить настройки" 
                                    Command="{Binding SaveConfigCommand}"
                                    Height="25"
                                    Margin="0,5"/>

                            <TextBlock Text="Настройки сохраняются в config.json"
                                       FontSize="10"
                                       Foreground="Gray"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Status Info -->
                    <Border Background="#f8f9fa" BorderBrush="#ddd" BorderThickness="1" 
                            CornerRadius="5" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Текущий статус:" FontWeight="Bold" Margin="0,0,0,5"/>

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Подключение:" Width="100"/>
                                <Ellipse Width="8" Height="8" Margin="5,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Red"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="LimeGreen"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding IsConnected, Converter={StaticResource BoolToString}}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Мониторинг:" Width="100"/>
                                <Ellipse Width="8" Height="8" Margin="5,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                    <Setter Property="Fill" Value="Orange"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding IsMonitoring, Converter={StaticResource BoolToString}, ConverterParameter='Активен|Выкл'}"/>
                            </StackPanel>

                            <Separator Margin="0,5"/>

                            <TextBlock Text="Активная ставка:" FontWeight="Bold" Margin="0,5,0,2"/>
                            <TextBlock Text="{Binding CurrentPrediction.Title}" 
                                       TextWrapping="Wrap"
                                       FontStyle="Italic"
                                       Foreground="#555"
                                       Visibility="{Binding CurrentPrediction, Converter={StaticResource NullToVisibilityConverter}}"/>
                            <TextBlock Text="Нет активных ставок" 
                                       FontStyle="Italic"
                                       Foreground="#999"
                                       Visibility="{Binding CurrentPrediction, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Invert'}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Panel - Logs -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Логи" Grid.Row="0">
                    <TextBox Text="{Binding LogText}" 
                            IsReadOnly="True" 
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            TextWrapping="Wrap"
                            FontFamily="Consolas"
                            FontSize="12"
                            Background="#1e1e1e"
                            Foreground="#d4d4d4"
                            BorderThickness="0"
                    TextChanged="LogTextBox_TextChanged"/>
                </GroupBox>

                <!-- Log Controls -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button Content="Очистить логи" 
                            Height="25" 
                            Width="100"
                            Click="ClearLogs_Click"
                            Margin="0,0,5,0"/>
                    <Button Content="Копировать логи" 
                            Height="25" 
                            Width="120"
                            Click="CopyLogs_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>